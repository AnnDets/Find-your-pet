const {fireEvent, render, screen} = require('@testing-library/react');
// Mock the window.location.href behavior
jest.mock('window.location.href', () => ({
    assign: jest.fn(),
}));

describe('Home Page Tests', () => {
  beforeEach(() => {
    document.body.innerHTML = `
      <button id="find">Find</button>
      <button id="lost">Lost</button>
      <button id="firstpetButton">Pet 1</button>
      <button id="Profile">Profile</button>
      <button id="Exit">Exit</button>
    `;
  });

  test('Find button redirects', () => {
    const findButton = document.getElementById('find');
    fireEvent.click(findButton);
    expect(window.location.assign).toHaveBeenCalledWith('find.html');
  });

  test('Lost button redirects', () => {
    const lostButton = document.getElementById('lost');
    fireEvent.click(lostButton);
    expect(window.location.assign).toHaveBeenCalledWith('lost.html');
  });

  test('Pet button redirects', () => {
    const petButton = document.getElementById('firstpetButton');
    fireEvent.click(petButton);
    expect(window.location.assign).toHaveBeenCalledWith('petpage.html');
  });

  test('Profile button redirects', () => {
    const profileButton = document.getElementById('Profile');
    fireEvent.click(profileButton);
    expect(window.location.assign).toHaveBeenCalledWith('profile.html');
  });

  test('Exit button shows alert and redirects', () => {
    const exitButton = document.getElementById('Exit');
    global.alert = jest.fn(); //Mock alert
    fireEvent.click(exitButton);
    expect(global.alert).toHaveBeenCalledWith('Вы вышли из профиля');
    expect(window.location.assign).toHaveBeenCalledWith('homeguest.html');
  });


});
